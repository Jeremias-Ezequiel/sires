# Base de datos (MySQL/MariaDB)
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASS=

# URL pública del sistema, sin barra final ni /sires (ej: https://hotel.ejemplo.com).
# Se usa para armar el enlace del mail de recuperación de contraseña.
APP_URL=

# SMTP para el mail de recuperación de contraseña (PHPMailer, STARTTLS)
SMTP_HOST=
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=

# API del reloj de asistencia
API_RELOJ_URL=
API_RELOJ_USER=
API_RELOJ_PASS=

# Remitente de los mails al huésped (opcional). Usan el mismo SMTP de arriba.
MAIL_FROM=
MAIL_FROM_NAME=
