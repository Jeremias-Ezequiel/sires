{
    "name": "vendor/sires",
    "description": "Hotel Reservation Management System",
    "type": "project",
    "require": {
        "vlucas/phpdotenv": "^5.6",
        "nikic/fast-route": "^1.3",
        "phpmailer/phpmailer": "^7.1",
        "dompdf/dompdf": "^3.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "App/"
        },
        "files": [
            "App/Helpers/functions.php"
        ]
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "phpstan/phpstan": "^2.1"
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit --testsuite unidad",
        "test:integracion": "phpunit --testsuite integracion",
        "phpstan": "phpstan analyse --memory-limit=512M",
        "lint": "find App cron tests/Unidad tests/Integracion tests/bootstrap.php index.php \\( -name '*.php' -o -name '*.phtml' \\) -print0 | xargs -0 -n1 -P4 php -l | (! grep -v '^No syntax errors')",
        "check": [
            "@lint",
            "@phpstan",
            "@test"
        ]
    }
}
