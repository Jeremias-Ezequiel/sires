            ?>
                <div class="auth-alert auth-alert-success" style="background-color: rgba(34, 197, 94, 0.1); color: #22c55e; border: 1px solid rgba(34, 197, 94, 0.2); padding: 12px 16px; border-radius: 6px; font-size: 14px; margin-bottom: 15px; font-weight: 500;">
