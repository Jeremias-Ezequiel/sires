    <!-- Cargando los estilos con la función global asset() -->
    <link rel="stylesheet" href="<?= asset('css/global.css') ?>">
    <link rel="stylesheet" href="<?= asset('css/pages/register.css') ?>">
</head>

<body>

    <div class="main-container">

        <div class="logo-side">
            <!-- Cargando el logo mediante la función global asset() -->
            <img src="<?= asset('img/logo.png') ?>" alt="Logo SIRES" class="logo-formulario">
        </div>

        <div class="register-card">
            <h2>CREAR CUENTA</h2>
            <p class="register-subtitle">
                Registrá un nuevo operador en el sistema
            </p>

            <?php if (session_status() === PHP_SESSION_NONE) {
                session_start();
            } ?>

            <?php if (isset($_SESSION['registro_exitoso'])): ?>
                <div class="alert alert--success">
                    <i class="fas fa-check-circle"></i>
                    <?= htmlspecialchars($_SESSION['registro_exitoso']) ?>
                </div>
                <?php unset($_SESSION['registro_exitoso']); ?>
            <?php endif; ?>

            <?php if (isset($_SESSION['registro_error'])): ?>
                <div class="alert alert--error">
                    <i class="fas fa-exclamation-circle"></i>
                    <?= htmlspecialchars($_SESSION['registro_error']) ?>
                </div>
                <?php unset($_SESSION['registro_error']); ?>
            <?php endif; ?>

            <!-- Pasando la ruta de procesamiento por la función global url() -->
            <form action="<?= url('/register/process') ?>" method="POST" autocomplete="off">

                <div class="form__row">
                    <div class="form__group">
                        <label class="form__label">Nombre</label>
                        <input type="text" name="nombre" id="nombre" placeholder="Ej. Juan" required class="form__input"
                            pattern="^[a-zA-ZáéíóúÁÉÍÓÚñÑ\s]+$"
                            title="El nombre solo puede contener letras y espacios.">
                    </div>
                    <div class="form__group">
                        <label class="form__label">Apellido</label>
                        <input type="text" name="apellido" id="apellido" placeholder="Ej. Pérez" required class="form__input"
                            pattern="^[a-zA-ZáéíóúÁÉÍÓÚñÑ\s]+$"
                            title="El apellido solo puede contener letras y espacios.">
                    </div>
                </div>

                <label class="form__label">Correo Electrónico</label>
                <input type="email" name="email" placeholder="operador@sires.com" required class="form__input">

                <div class="form__row">
                    <div class="form__group">
                        <label class="form__label">Contraseña</label>
                        <input type="password" name="password" placeholder="••••••••" required class="form__input">
                    </div>
                    <div class="form__group">
                        <label class="form__label">Confirmar Contraseña</label>
                        <input type="password" name="confirm_password" placeholder="••••••••" required class="form__input">
                    </div>
                </div>

                <label class="form__label">Asignar Rol del Sistema</label>
                <select name="rol" required class="form__select">
                    <option value="" disabled selected>Seleccione un rol...</option>
                    <?php if (isset($roles) && is_array($roles)): ?>
                        <?php foreach ($roles as $rol): ?>
                            <option value="<?= $rol['id'] ?>"><?= $rol['descripcion'] ?></option>
                        <?php endforeach; ?>
                    <?php endif; ?>
                </select>

                <div class="form__actions form__actions--stack">
                    <button type="submit" class="btn btn--primary btn--full">REGISTRARSE</button>

                    <!-- Pasando el retorno al inicio por la función global url() -->
                    <a href="<?= url('/dashboard') ?>" class="btn btn--ghost btn--full">
                        <i class="fas fa-arrow-left"></i> Volver al Inicio
                    </a>
                </div>
            </form>
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const form = document.querySelector('form');
            const password = document.querySelector('input[name="password"]');
            const confirmPassword = document.querySelector('input[name="confirm_password"]');
            const inputNombre = document.getElementById('nombre');
            const inputApellido = document.getElementById('apellido');

            // 🚫 Bloqueo absoluto de números y símbolos (Escritura, pegado y arrastrado)
            const inputsLetras = [inputNombre, inputApellido];
            inputsLetras.forEach(input => {
                if (input) {
                    // 1. Al escribir
                    input.addEventListener('keypress', function(e) {
                        const regex = /^[a-zA-ZáéíóúÁÉÍÓÚñÑ\s]$/;
                        if (!regex.test(e.key)) {
                            e.preventDefault();
                        }
                    });

                    // 2. Al cambiar el contenido dinámicamente
                    input.addEventListener('input', function() {
                        this.value = this.value.replace(/[^a-zA-ZáéíóúÁÉÍÓÚñÑ\s]/g, '');
                    });

                    // 3. Al pegar texto explícitamente
                    input.addEventListener('paste', function(e) {
                        const dataPegada = (e.clipboardData || window.clipboardData).getData('text');
                        const regexGeneral = /^[a-zA-ZáéíóúÁÉÍÓÚñÑ\s]+$/;
                        if (!regexGeneral.test(dataPegada)) {
                            e.preventDefault();
                            alert('❌ No podés pegar números o símbolos en este campo.');
                        }
                    });
                }
            });

            // Validación de coincidencia de contraseñas
            form.addEventListener('submit', function(e) {
                if (password.value !== confirmPassword.value) {
                    e.preventDefault();
                    alert('❌ Las contraseñas no coinciden. Por favor, revisalas antes de continuar.');
                    password.style.borderColor = '#ef4444';
                    confirmPassword.style.borderColor = '#ef4444';
                    confirmPassword.focus();
                }
            });

            [password, confirmPassword].forEach(input => {
                input.addEventListener('input', function() {
                    password.style.borderColor = '';
                    confirmPassword.style.borderColor = '';
                });
            });
        });
    </script>

</body>

</html>
