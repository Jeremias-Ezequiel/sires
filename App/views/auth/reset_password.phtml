    <script>
        // âœ… Checklist en vivo de requisitos de contraseÃ±a
        document.addEventListener('DOMContentLoaded', function() {
            const password = document.getElementById('password');
            const rules = {
                'ruleLength': v => v.length >= 8,
                'ruleUpper':  v => /[A-Z]/.test(v),
                'ruleNumber': v => /\d/.test(v)
            };

            function actualizarChecklist(rulesMap) {
                if (!password) return;
                const val = password.value;
                Object.keys(rulesMap).forEach(function(id) {
                    const li = document.getElementById(id);
                    if (!li) return;
                    const ok = rulesMap[id](val);
                    li.classList.toggle('is-checked', ok);
                    li.classList.toggle('is-valid', ok); // compatibilidad con ambas convenciones
                    const icon = li.querySelector('i');
                    if (icon) icon.className = 'fa-solid ' + (ok ? 'fa-circle-check' : 'fa-circle');
                });
            }

            if (password) {
                password.addEventListener('input', function() {
                    actualizarChecklist(rules);
                });
                actualizarChecklist(rules); // estado inicial
            }
        });
    </script>

