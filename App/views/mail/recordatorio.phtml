 * @var callable $fecha
 */
$saldo = (float)($reserva['saldo_pendiente'] ?? 0);
?>
<h1 style="margin:0 0 12px;font-size:20px;font-weight:600;">¡Te esperamos, <?= $e($reserva['cliente_nombre']) ?>!</h1>
