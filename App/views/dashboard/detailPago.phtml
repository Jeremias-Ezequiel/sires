<script>
    document.addEventListener('DOMContentLoaded', function() {
        const formulario = document.querySelector('.payment-form');
        const inputMonto = document.getElementById('monto_abonado');

        if (formulario && inputMonto) {
            const saldoPendiente = <?= json_encode($resumen !== null ? $resumen->getSaldoPendiente() : 0.0) ?>;

            inputMonto.addEventListener('input', function() {
                const raw = this.value.replace(',', '.');
                if (raw === '' || raw === '.') return;
                const value = parseFloat(raw);
                if (!isNaN(value) && value > saldoPendiente) {
                    this.value = this._lastValid ?? '';
                } else {
                    this._lastValid = this.value;
                }
            });

            formulario.addEventListener('submit', function(e) {
                const monto = parseFloat(inputMonto.value.trim());

                if (isNaN(monto) || monto <= 0) {
                    e.preventDefault();
                    alert('El monto a abonar debe ser mayor a 0.');
                    inputMonto.focus();
                    return;
                }

                if (monto > saldoPendiente) {
                    e.preventDefault();
                    alert('El monto supera el saldo pendiente de $' + saldoPendiente.toFixed(2).replace('.', ',') + '.');
                    inputMonto.focus();
                    return;
                }
            });
        }
    });

    // Modal handler
    const modalBtns = document.querySelectorAll('.open-sires-modal');
    modalBtns.forEach(function(button) {
        button.addEventListener('click', function() {
            const actionType = this.getAttribute('data-action');
            const targetUrl = this.getAttribute('data-url');
            const reservaName = this.getAttribute('data-name');
            const modal = document.getElementById('sires-confirm-modal');
            const modalIconFrame = document.getElementById('modal-icon-frame');
            const modalIcon = document.getElementById('modal-action-icon');
            const modalTitle = document.getElementById('modal-title-text');
            const modalText = document.getElementById('modal-description-text');
            const btnConfirm = document.getElementById('btn-modal-confirm');
            const btnCancel = document.getElementById('btn-modal-cancel');
            const refundForm = document.getElementById('refund-form');

            if (!modal) return;

            modalIconFrame.className = 'modal__icon';
            btnConfirm.className = 'btn';

            if (actionType === 'recalculate') {
                modalTitle.innerText = 'Recalcular Precio';
                modalText.innerHTML = `¿Está seguro de que desea recalcular el precio de <br><strong>${reservaName}</strong>?<br><small>El monto total se actualizará al precio actual de la habitación.</small>`;
                modalIcon.className = 'fas fa-calculator';
                modalIconFrame.classList.add('modal__icon--warning');
                btnConfirm.classList.add('btn--warning');
                btnConfirm.setAttribute('href', targetUrl);
                btnConfirm.onclick = null;
            } else if (actionType === 'refund') {
                const monto = this.getAttribute('data-monto') ?? '0,00';
                modalTitle.innerText = 'Procesar Reembolso';
                modalText.innerHTML = `¿Está seguro de que desea reembolsar <strong>$${monto}</strong> a<br><strong>${reservaName}</strong>?<br><small>Se registrará una transacción de egreso y el resumen se dará de baja.</small>`;
                modalIcon.className = 'fas fa-undo-alt';
                modalIconFrame.classList.add('modal__icon--danger');
                btnConfirm.classList.add('btn--danger');
                btnConfirm.setAttribute('href', '#');
                btnConfirm.onclick = function() {
                    if (refundForm) refundForm.submit();
                };
            }

            modal.classList.add('is-active');

            btnCancel.addEventListener('click', function() {
                modal.classList.remove('is-active');
            });
        });
    });
</script>

<!-- MODAL DE CONFIRMACIÓN SIRES -->
