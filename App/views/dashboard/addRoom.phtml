<script>
    const HABITACIONES = <?= json_encode($todasHabitaciones ?? []) ?>;
    const PISOS = <?= json_encode($pisos ?? []) ?>;

    document.addEventListener('DOMContentLoaded', function() {
        const selectPiso = document.getElementById('piso');
        const inputNumero = document.getElementById('numero');
        const numeroGroup = document.getElementById('numero-group');
        const numeroSugeridoLabel = document.getElementById('numero-sugerido-label');
        const previewTitle = document.getElementById('preview-title');
        const roomPreview = document.getElementById('room-preview');
        const inputPrecio = document.getElementById('precio_noche_base');

        function getNextRoomNumber(piso) {
            let max = 0;
            HABITACIONES.forEach(function(h) {
                if (parseInt(h.piso) === piso) {
                    let num = parseInt(h.numero);
                    if (num > max) max = num;
                }
            });
            if (max === 0) return piso * 100 + 1;
            return max + 1;
        }

        function actualizarPreview() {
            const piso = parseInt(selectPiso.value);

            if (!piso || piso <= 0) {
                previewTitle.style.display = 'none';
                roomPreview.style.display = 'none';
                numeroGroup.style.display = 'none';
                return;
            }

            const nextNum = getNextRoomNumber(piso);
            const indice = nextNum - piso * 100;

            inputNumero.value = indice;

            numeroGroup.style.display = 'block';

            const numeroFinal = piso * 100 + parseInt(inputNumero.value);
            numeroSugeridoLabel.textContent = '→ N° ' + numeroFinal;

            previewTitle.style.display = 'block';
            roomPreview.style.display = 'block';
            roomPreview.innerHTML = `
                <div style="display: flex; flex-wrap: wrap; gap: 8px; align-items: center; padding: 12px; background: var(--fondo-panel); border-radius: 8px;">
                    <span class="badge badge--disponible" style="padding: 6px 14px; font-size: 1em;">
                        <i class="fas fa-layer-group"></i> Piso ${piso}
                    </span>
                    <span class="badge badge--disponible" style="padding: 6px 14px; font-size: 1em;">
                        <i class="fas fa-door-open"></i> Habitación N° ${numeroFinal}
                    </span>
                    <span style="color: var(--texto-gris); font-size: 0.85em;">
                        (índice ${inputNumero.value})
                    </span>
                </div>
            `;
        }

        selectPiso.addEventListener('change', actualizarPreview);

        if (inputPrecio) {
            inputPrecio.addEventListener('keypress', function(e) {
                if (!/[0-9.]/.test(e.key)) e.preventDefault();
            });
            inputPrecio.addEventListener('input', function() {
                this.value = this.value.replace(/[^0-9.]/g, '');
            });
            inputPrecio.addEventListener('paste', function(e) {
                const dataPegada = (e.clipboardData || window.clipboardData).getData('text');
                if (!/^[0-9]+(\.[0-9]{1,2})?$/.test(dataPegada)) {
                    e.preventDefault();
                    document.getElementById('alert-container').innerHTML = `
                        <div class="alert alert--error">
                            <i class="fa-solid fa-triangle-exclamation"></i>
                            Solo se permiten valores numéricos en el precio (ej: 15000 o 15000.50).
                        </div>
                    `;
                    window.scrollTo({ top: 0, behavior: 'smooth' });
                }
            });
        }

        actualizarPreview();
    });
</script>