<script>
    document.addEventListener('DOMContentLoaded', function() {
        // --- 👁️ Lógica Ocultar/Mostrar Contraseñas ---
        const setupTogglePassword = (toggleId, inputId) => {
            const toggle = document.querySelector(toggleId);
            const input = document.querySelector(inputId);
            if (toggle && input) {
                toggle.addEventListener('click', function() {
                    const type = input.getAttribute('type') === 'password' ? 'text' : 'password';
                    input.setAttribute('type', type);
                    this.classList.toggle('fa-eye-slash');
                });
            }
        };
        setupTogglePassword('#togglePassword', '#password');
        setupTogglePassword('#toggleConfirmPassword', '#confirm_password');

        // --- 🚫 Validar Coincidencia de Contraseñas e Inyección de Alerta HTML ---
        const formulario = document.querySelector('.employee-form');
        const pass = document.getElementById('password');
        const confirmPass = document.getElementById('confirm_password');
        const alertContainer = document.getElementById('alert-container');

        if (formulario && pass && confirmPass && alertContainer) {
            formulario.addEventListener('submit', function(e) {
                if (pass.value !== confirmPass.value) {
                    e.preventDefault(); // Frena el envío del formulario
                    
                    // Inyectamos dinámicamente la estructura idéntica a tus flashes del Backend
                    alertContainer.innerHTML = `
                        <div class="alert alert-error">
                            <i class="fa-solid fa-triangle-exclamation"></i>
                            Las contraseñas ingresadas no coinciden. Por favor, verificalas.
                        </div>
                    `;
                    
                    // Hacemos scroll hacia arriba de forma fluida para que el operador vea el cartel de inmediato
                    window.scrollTo({ top: 0, behavior: 'smooth' });
                    
                    confirmPass.focus();
                }
            });
        }

        // --- 🚫 Bloqueo absoluto de números y símbolos en Nombre/Apellido ---
        const inputNombre = document.getElementById('nombre');
        const inputApellido = document.getElementById('apellido');

        if (inputNombre && inputApellido) {
            const inputsLetras = [inputNombre, inputApellido];
            inputsLetras.forEach(input => {
                input.addEventListener('keypress', function(e) {
                    const regex = /^[a-zA-ZáéíóúÁÉÍÓÚñÑ\s]$/;
                    if (!regex.test(e.key)) e.preventDefault();
                });
                input.addEventListener('input', function() {
                    this.value = this.value.replace(/[^a-zA-ZáéíóúÁÉÍÓÚñÑ\s]/g, '');
                });
                input.addEventListener('paste', function(e) {
                    const dataPegada = (e.clipboardData || window.clipboardData).getData('text');
                    const regexGeneral = /^[a-zA-ZáéíóúÁÉÍÓÚñÑ\s]+$/;
                    if (!regexGeneral.test(dataPegada)) {
                        e.preventDefault();
                        
                        alertContainer.innerHTML = `
                            <div class="alert alert-error">
                                <i class="fa-solid fa-triangle-exclamation"></i>
                                No podés pegar números o símbolos en los campos de nombre o apellido.
                            </div>
                        `;
                        window.scrollTo({ top: 0, behavior: 'smooth' });
                    }
                });
                input.addEventListener('drop', function(e) { e.preventDefault(); });
            });
        }

        // --- 🌍 Lógica de Dependencia Escalonada de Ubicación ---
        const selectNacionalidad = document.getElementById('id_nacionalidad');
        const selectProvincia = document.getElementById('id_provincia');
        const selectLocalidad = document.getElementById('id_localidad');

        if (selectNacionalidad && selectProvincia && selectLocalidad) {
            selectNacionalidad.addEventListener('change', function() {
                if (this.value !== "") {
                    selectProvincia.disabled = false;
                } else {
                    selectProvincia.disabled = true;
                    selectLocalidad.disabled = true;
                    selectProvincia.value = "";
                    selectLocalidad.value = "";
                }
            });

            selectProvincia.addEventListener('change', function() {
                if (this.value !== "") {
                    selectLocalidad.disabled = false;
                } else {
                    selectLocalidad.disabled = true;
                    selectLocalidad.value = "";
                }
            });
        }
    });
</script>