<!-- MODAL DE CONFIRMACIÓN SIRES -->
<div id="sires-confirm-modal" class="sires-modal-overlay">
    <div class="sires-modal-box">
        <div id="modal-icon-frame" class="sires-modal-icon">
            <i id="modal-action-icon" class="fas fa-exclamation-triangle"></i>
        </div>
        <h3 id="modal-title-text">Confirmar Acción</h3>
        <p id="modal-description-text">¿Estás seguro de que deseas continuar?</p>
        <div class="sires-modal-actions">
            <button type="button" id="btn-modal-cancel" class="btn btn--ghost">Cancelar</button>
            <a href="#" id="btn-modal-confirm" class="btn">Confirmar</a>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        // --- [ VALIDACIONES DEL BUSCADOR ] ---
        const inputSearch = document.getElementById('search');
        if (inputSearch) {
            inputSearch.addEventListener('keypress', function(e) {
                const regex = /^[a-zA-ZáéíóúÁÉÍÓÚñÑ\s]$/;
                if (!regex.test(e.key)) e.preventDefault();
            });
            inputSearch.addEventListener('input', function() {
                this.value = this.value.replace(/[^a-zA-ZáéíóúÁÉÍÓÚñÑ\s]/g, '');
            });
            inputSearch.addEventListener('paste', function(e) {
                const dataPegada = (e.clipboardData || window.clipboardData).getData('text');
                const regexGeneral = /^[a-zA-ZáéíóúÁÉÍÓÚñÑ\s]+$/;
                if (!regexGeneral.test(dataPegada)) {
                    e.preventDefault();
                }
            });
            inputSearch.addEventListener('drop', function(e) {
                e.preventDefault();
            });
        }

        // --- [ CONTROL DEL MODAL ESTILIZADO DE SIRES ] ---
        const modal = document.getElementById('sires-confirm-modal');
        const modalIconFrame = document.getElementById('modal-icon-frame');
        const modalIcon = document.getElementById('modal-action-icon');
        const modalTitle = document.getElementById('modal-title-text');
        const modalText = document.getElementById('modal-description-text');
        const btnConfirm = document.getElementById('btn-modal-confirm');
        const btnCancel = document.getElementById('btn-modal-cancel');

        // Escuchamos los clics en los botones de Alta/Baja
        const buttons = document.querySelectorAll('.open-sires-modal');
        buttons.forEach(button => {
            button.addEventListener('click', function() {
                const actionType = this.getAttribute('data-action');
                const targetUrl = this.getAttribute('data-url');
                const employeeName = this.getAttribute('data-name');

                // Limpiamos estados de clases previas
                modalIconFrame.className = 'sires-modal-icon';
                btnConfirm.className = 'btn';

                if (actionType === 'deactivate') {
                    modalTitle.innerText = 'Dar de Baja Empleado';
                    modalText.innerHTML = `¿Está seguro de que desea dar de baja al empleado <br><strong>${employeeName}</strong>?`;
                    modalIcon.className = 'fas fa-user-minus';
                    modalIconFrame.classList.add('icon-deactivate');
                    btnConfirm.classList.add('btn--danger');
                } else if (actionType === 'activate') {
                    modalTitle.innerText = 'Reactivar Empleado';
                    modalText.innerHTML = `¿Está seguro de que desea reactivar al empleado <br><strong>${employeeName}</strong>?`;
                    modalIcon.className = 'fas fa-user-plus';
                    modalIconFrame.classList.add('icon-activate');
                    btnConfirm.classList.add('btn--success');
                }

                // Asignamos la URL real del controlador al botón "Confirmar"
                btnConfirm.setAttribute('href', targetUrl);
                
                // Mostramos el modal añadiendo la clase active
                modal.classList.add('active');
            });
        });

        // Cerrar modal al hacer clic en Cancelar
        btnCancel.addEventListener('click', function() {
            modal.classList.remove('active');
        });
        
        // Cerrar modal si se hace clic fuera de la caja contenedora
        modal.addEventListener('click', function(e) {
            if (e.target === modal) {
                modal.classList.remove('active');
            }
        });
    });
</script>
