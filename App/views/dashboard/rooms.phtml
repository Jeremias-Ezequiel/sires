<div id="sires-confirm-modal" class="modal">
    <div class="modal__box">
        <div id="modal-icon-frame" class="modal__icon">
            <i id="modal-action-icon" class="fas fa-exclamation-triangle"></i>
        </div>
        <h3 id="modal-title-text" class="modal__title">Confirmar Acción</h3>
        <p id="modal-description-text" class="modal__desc">¿Estás seguro de que deseas continuar?</p>
        <div id="motivo-select-wrapper" style="display: none; margin-top: 12px;">
            <label for="modal-motivo-select" style="display: block; font-weight: 600; margin-bottom: 4px;">Motivo del bloqueo:</label>
            <select id="modal-motivo-select" class="form__select" style="width: 100%;">
                <option value="">Sin motivo específico</option>
                <?php if (!empty($motivos)): ?>
                    <?php foreach ($motivos as $motivo): ?>
                        <option value="<?= $motivo['id'] ?>"><?= htmlspecialchars($motivo['descripcion']) ?></option>
                    <?php endforeach; ?>
                <?php endif; ?>
            </select>
        </div>
        <div class="modal__actions">
            <button type="button" id="btn-modal-cancel" class="btn btn--ghost">Cancelar</button>
            <a href="#" id="btn-modal-confirm" class="btn">Confirmar</a>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const modal = document.getElementById('sires-confirm-modal');
        const modalIconFrame = document.getElementById('modal-icon-frame');
        const modalIcon = document.getElementById('modal-action-icon');
        const modalTitle = document.getElementById('modal-title-text');
        const modalText = document.getElementById('modal-description-text');
        const btnConfirm = document.getElementById('btn-modal-confirm');
        const btnCancel = document.getElementById('btn-modal-cancel');
        const motivoWrapper = document.getElementById('motivo-select-wrapper');
        const motivoSelect = document.getElementById('modal-motivo-select');

        const buttons = document.querySelectorAll('.open-sires-modal');
        buttons.forEach(button => {
            button.addEventListener('click', function() {
                const actionType = this.getAttribute('data-action');
                const targetUrl = this.getAttribute('data-url');
                const roomName = this.getAttribute('data-name');

                modalIconFrame.className = 'modal__icon';
                btnConfirm.className = 'btn';

                if (actionType === 'deactivate') {
                    modalTitle.innerText = 'Bloquear Habitación';
                    modalText.innerHTML = `¿Está seguro de que desea bloquear la <br><strong>${roomName}</strong>?`;
                    modalIcon.className = 'fas fa-bed';
                    modalIconFrame.classList.add('modal__icon--deactivate');
                    btnConfirm.classList.add('btn--danger');
                    motivoWrapper.style.display = 'block';
                } else if (actionType === 'activate') {
                    modalTitle.innerText = 'Reactivar Habitación';
                    modalText.innerHTML = `¿Está seguro de que desea reactivar la <br><strong>${roomName}</strong>?`;
                    modalIcon.className = 'fas fa-bed';
                    modalIconFrame.classList.add('modal__icon--activate');
                    btnConfirm.classList.add('btn--success');
                    motivoWrapper.style.display = 'none';
                } else if (actionType === 'delete') {
                    modalTitle.innerText = 'Dar de Baja';
                    modalText.innerHTML = `¿Dar de baja la <br><strong>${roomName}</strong>? Se liberará su número para ser reutilizado.`;
                    modalIcon.className = 'fas fa-trash';
                    modalIconFrame.classList.add('modal__icon--deactivate');
                    btnConfirm.classList.add('btn--danger');
                    motivoWrapper.style.display = 'none';
                } else if (actionType === 'reactivate') {
                    modalTitle.innerText = 'Reactivar Habitación';
                    modalText.innerHTML = `¿Está seguro de que desea reactivar la <br><strong>${roomName}</strong>?<br><small>La habitación volverá a estar disponible para la venta.</small>`;
                    modalIcon.className = 'fas fa-undo';
                    modalIconFrame.classList.add('modal__icon--activate');
                    btnConfirm.classList.add('btn--success');
                    motivoWrapper.style.display = 'none';
                } else if (actionType === 'cleaning') {
                    modalTitle.innerText = 'Iniciar Limpieza';
                    modalText.innerHTML = `¿Está seguro de que desea iniciar la limpieza de la <br><strong>${roomName}</strong>?<br><small>La habitación pasará a estado "Limpiando".</small>`;
                    modalIcon.className = 'fas fa-broom';
                    modalIconFrame.classList.add('modal__icon--activate');
                    btnConfirm.classList.add('btn--warning');
                    motivoWrapper.style.display = 'none';
                } else if (actionType === 'complete-cleaning') {
                    modalTitle.innerText = 'Completar Limpieza';
                    modalText.innerHTML = `¿Está seguro de que desea marcar como limpia la <br><strong>${roomName}</strong>?<br><small>La habitación volverá a estar disponible para la venta.</small>`;
                    modalIcon.className = 'fas fa-check-circle';
                    modalIconFrame.classList.add('modal__icon--activate');
                    btnConfirm.classList.add('btn--success');
                    motivoWrapper.style.display = 'none';
                }

                let finalUrl = targetUrl;
                if (actionType === 'deactivate' && motivoSelect) {
                    const motivoVal = motivoSelect.value;
                    if (motivoVal !== '') {
                        finalUrl = targetUrl + '&motivo=' + encodeURIComponent(motivoVal);
                    }
                }
                btnConfirm.setAttribute('href', finalUrl);

                modal.classList.add('is-active');
            });
        });

        btnCancel.addEventListener('click', function() {
            modal.classList.remove('is-active');
        });

        modal.addEventListener('click', function(e) {
            if (e.target === modal) {
                modal.classList.remove('is-active');
            }
        });
    });
</script>
