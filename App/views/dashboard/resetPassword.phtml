<section class="details-section form-container-section">
    <!-- El formulario apunta al proceso de cambio de clave -->
    <form action="/sires/dashboard/employees/reset-password/process" method="POST" class="employee-form">
        <?= csrf_field() ?>
        <!-- Pasamos el ID del usuario de forma oculta -->
        <input type="hidden" name="id" value="<?= htmlspecialchars((string)($employee->getId() ?? '')) ?>">

        <div class="form__section-title">
            <i class="fas fa-lock"></i> Credenciales para <?= htmlspecialchars($employee->getNombre() . ' ' . $employee->getApellido()) ?>
        </div>

        <div class="form__grid">
            <div class="form__group">
                <label class="form__label" for="password">Nueva Contraseña</label>
                <input type="password" id="password" name="password" placeholder="Mínimo 5 caracteres" required class="form__input" autocomplete="new-password">
            </div>

            <div class="form__group">
                <label class="form__label" for="confirm_password">Confirmar Nueva Contraseña</label>
                <input type="password" id="confirm_password" name="confirm_password" placeholder="Repita la contraseña" required class="form__input" autocomplete="new-password">
            </div>
        </div>

        <div class="form__actions">
            <button type="submit" class="btn btn--primary">
                <i class="fas fa-key"></i> Actualizar Contraseña
            </button>
        </div>
    </form>
</section>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const formulario = document.querySelector('.employee-form');
        const alertContainer = document.getElementById('alert-container');
        const inputPassword = document.getElementById('password');
        const inputConfirm = document.getElementById('confirm_password');

        function mostrarError(mensaje) {
            alertContainer.innerHTML = `
                <div class="alert alert--error">
                    <i class="fa-solid fa-triangle-exclamation"></i>
                    ${mensaje}
                </div>
            `;
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        if (formulario && alertContainer) {
            formulario.addEventListener('submit', function(e) {
                alertContainer.innerHTML = '';

                const passVal = inputPassword?.value ?? '';
                const confirmVal = inputConfirm?.value ?? '';

                if (passVal.length < 8) {
                    e.preventDefault();
                    mostrarError('La contraseña debe tener al menos 8 caracteres.');
                    inputPassword?.focus();
                    return;
                }

                if (!/[A-Z]/.test(passVal)) {
                    e.preventDefault();
                    mostrarError('La contraseña debe contener al menos una letra mayúscula.');
                    inputPassword?.focus();
                    return;
                }

                if (!/\d/.test(passVal)) {
                    e.preventDefault();
                    mostrarError('La contraseña debe contener al menos un número.');
                    inputPassword?.focus();
                    return;
                }

                if (passVal !== confirmVal) {
                    e.preventDefault();
                    mostrarError('Las contraseñas ingresadas no coinciden.');
                    inputConfirm?.focus();
                    return;
                }
            });
        }
    });
</script>