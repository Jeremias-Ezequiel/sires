<script>
    document.addEventListener('DOMContentLoaded', function() {
        const modal = document.getElementById('sires-confirm-modal');
        const modalIconFrame = document.getElementById('modal-icon-frame');
        const modalIcon = document.getElementById('modal-action-icon');
        const modalTitle = document.getElementById('modal-title-text');
        const modalText = document.getElementById('modal-description-text');
        const btnCancel = document.getElementById('btn-modal-cancel');
        const csrfForm = document.getElementById('csrf-form');
        const actionId = document.getElementById('modal-action-id');
        const btnConfirm = document.getElementById('btn-modal-confirm');

        const buttons = document.querySelectorAll('.open-sires-modal');
        buttons.forEach(button => {
            button.addEventListener('click', function() {
                const actionType = this.getAttribute('data-action');
                const targetUrl = this.getAttribute('data-url');
                const reservaName = this.getAttribute('data-name');
                const reservaId = this.getAttribute('data-id');

                modalIconFrame.className = 'modal__icon';
                btnConfirm.className = 'btn';

                if (actionType === 'checkin') {
                    modalTitle.innerText = 'Realizar Check-in';
                    modalText.innerHTML = `¿Está seguro de que desea realizar el check-in de la <br><strong>${escHtml(reservaName)}</strong>?`;
                    modalIcon.className = 'fas fa-door-open';
                    modalIconFrame.classList.add('modal__icon--activate');
                    btnConfirm.classList.add('btn--success');
                } else if (actionType === 'finalize') {
                    modalTitle.innerText = 'Finalizar Reserva';
                    modalText.innerHTML = `¿Está seguro de que desea finalizar la <br><strong>${escHtml(reservaName)}</strong>? Se liberará la habitación.`;
                    modalIcon.className = 'fas fa-flag-checkered';
                    modalIconFrame.classList.add('modal__icon--activate');
                    btnConfirm.classList.add('btn--success');
                } else if (actionType === 'noshow') {
                    modalTitle.innerText = 'Marcar como No-Show';
                    modalText.innerHTML = `¿Está seguro de que desea marcar la <br><strong>${escHtml(reservaName)}</strong> como No-Show?<br><small>Si tiene pago, la habitación queda retenida hasta el checkout del día siguiente; si el huésped no llega, se cobra la 1.ª noche y el resto se reembolsa.</small>`;
                    modalIcon.className = 'fas fa-user-slash';
                    modalIconFrame.classList.add('modal__icon--deactivate');
                    btnConfirm.classList.add('btn--danger');
                } else if (actionType === 'early-checkout') {
                    modalTitle.innerText = 'Checkout Anticipado';
                    modalText.innerHTML = `¿Está seguro de que desea realizar el checkout anticipado de la <br><strong>${escHtml(reservaName)}</strong>?<br><small>Sin reembolso por días no usados.</small>`;
                    modalIcon.className = 'fas fa-door-open';
                    modalIconFrame.classList.add('modal__icon--activate');
                    btnConfirm.classList.add('btn--warning');
                }

                csrfForm.action = targetUrl;
                actionId.value = reservaId;
                modal.classList.add('is-active');
            });
        });

        btnCancel.addEventListener('click', function() {
            modal.classList.remove('is-active');
        });

        modal.addEventListener('click', function(e) {
            if (e.target === modal) {
                modal.classList.remove('is-active');
            }
        });

        // Upgrade Modal
        const upgradeModal = document.getElementById('upgrade-modal');
        const btnUpgrade = document.getElementById('btn-upgrade');
        const btnUpgradeCancel = document.getElementById('btn-upgrade-cancel');

        if (btnUpgrade) {
            btnUpgrade.addEventListener('click', function() {
                upgradeModal.classList.add('is-active');
            });
        }

        if (btnUpgradeCancel) {
            btnUpgradeCancel.addEventListener('click', function() {
                upgradeModal.classList.remove('is-active');
            });
        }

        if (upgradeModal) {
            upgradeModal.addEventListener('click', function(e) {
                if (e.target === upgradeModal) {
                    upgradeModal.classList.remove('is-active');
                }
            });
        }
    });
</script>