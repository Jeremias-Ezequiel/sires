                <tbody>
                    <?php foreach ($pagos as $pag): ?>
                        <?php
                        $estadoPagoLower = mb_strtolower($pag['estado_pago_descripcion'] ?? '', 'UTF-8');
                        $pagoStatusClass = 'badge--desconocido';
                        if (strpos($estadoPagoLower, 'pendient') !== false) {
                            $pagoStatusClass = 'badge--pendiente';
                        } elseif (strpos($estadoPagoLower, 'parcial') !== false) {
                            $pagoStatusClass = 'badge--reservada';
                        } elseif (strpos($estadoPagoLower, 'retenid') !== false) {
                            $pagoStatusClass = 'badge--warning';
                        } elseif (strpos($estadoPagoLower, 'reembols') !== false) {
                            $pagoStatusClass = 'badge--ocupada';
                        } elseif (strpos($estadoPagoLower, 'a reembolsar') !== false) {
                            $pagoStatusClass = 'badge--warning';
                        }

                        $reservaEstadoLower = mb_strtolower($pag['estado_descripcion'] ?? '', 'UTF-8');
                        $reservaStatusClass = 'badge--disponible';
                        if (strpos($reservaEstadoLower, 'pendient') !== false) {
                            $reservaStatusClass = 'badge--pendiente';
                        } elseif (strpos($reservaEstadoLower, 'confirm') !== false) {
                            $reservaStatusClass = 'badge--reservada';
                        } elseif (strpos($reservaEstadoLower, 'cancel') !== false) {
                            $reservaStatusClass = 'badge--ocupada';
                        } elseif (strpos($reservaEstadoLower, 'no-show con pago') !== false) {
                            $reservaStatusClass = 'badge--reservada';
                        } elseif (strpos($reservaEstadoLower, 'finaliz') !== false) {
                            $reservaStatusClass = 'badge--disponible';
                        }

                        $saldoPago = isset($pag['saldo_pendiente']) && $pag['saldo_pendiente'] !== null ? (float)$pag['saldo_pendiente'] : 0.0;
                        ?>

                        <tr>
                            <td><strong>#<?= htmlspecialchars((string)$pag['id']) ?></strong></td>
                            <td><?= htmlspecialchars($pag['cliente_nombre'] . ' ' . $pag['cliente_apellido']) ?></td>
                            <td>#<?= htmlspecialchars((string)$pag['habitacion_numero']) ?></td>
                            <td><span class="badge <?= $reservaStatusClass ?>"><?= htmlspecialchars($pag['estado_descripcion']) ?></span></td>
                            <td>
                                <?php if (isset($pag['estado_pago_descripcion'])): ?>
                                    <span class="badge <?= $pagoStatusClass ?>"><?= htmlspecialchars($pag['estado_pago_descripcion']) ?></span>
                                <?php else: ?>
                                    <span class="badge badge--desconocido">Sin registro</span>
                                <?php endif; ?>
                            </td>
                            <td><?= isset($pag['monto_total']) && $pag['monto_total'] !== null ? '$' . number_format((float)$pag['monto_total'], 2, ',', '.') : '-' ?></td>
                            <td><?= isset($pag['monto_cobrado']) && $pag['monto_cobrado'] !== null ? '$' . number_format((float)$pag['monto_cobrado'], 2, ',', '.') : '-' ?></td>
                            <td><?= isset($pag['saldo_pendiente']) && $pag['saldo_pendiente'] !== null ? '$' . number_format($saldoPago, 2, ',', '.') : '-' ?></td>
                            <td class="cell-actions">
                                <div class="actions-group-container">
                                    <a href="<?= url('/dashboard/payments/detail?id=' . $pag['id']) ?>" class="btn btn--icon btn--icon-pass" title="Ver Detalle">
                                        <i class="fas fa-eye"></i>
                                    </a>
                                    <?php if ($saldoPago > 0 && mb_strpos($reservaEstadoLower, 'cancel') === false): ?>
