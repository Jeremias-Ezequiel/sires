<section class="details-section filter-section">
    <?= \App\Helpers\UrlHelper::openForm('/dashboard/payments', 'GET', 'filter-form') ?>

        <div class="form-group-search">
            <label class="form__label">Buscar</label>
            <div class="search-input-wrapper">
                <i class="fas fa-search search-icon"></i>
                <input type="text" name="search" placeholder="Cliente o habitación..." value="<?= htmlspecialchars($search ?? '') ?>" class="form__search-input" autocomplete="off">
            </div>
        </div>

        <div class="form-group-role">
            <label class="form__label">Filtrar por Estado de Pago</label>
            <select name="estado_pago_filter" class="form__select-filter">
                <option value="">Todos los Estados</option>
                <?php if (!empty($estadosPago)): ?>
                    <?php foreach ($estadosPago as $est): ?>
                        <option value="<?= (int)$est['id'] ?>" <?= ($estadoPago ?? '') === (string)$est['id'] ? 'selected' : '' ?>><?= htmlspecialchars($est['descripcion']) ?></option>
                    <?php endforeach; ?>
                <?php endif; ?>
            </select>
        </div>

        <button type="submit" class="btn btn--primary">
            <i class="fas fa-filter"></i> Filtrar
        </button>
        <?php if ($hasSearch || $hasEstado): ?>
            <a href="<?= url('/dashboard/payments') ?>" class="btn btn--ghost">
