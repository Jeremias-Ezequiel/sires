<script>
    document.addEventListener('DOMContentLoaded', function() {
        const formulario = document.querySelector('.employee-form');
        const alertContainer = document.getElementById('alert-container');
        const inputNombre = document.getElementById('nombre');
        const inputApellido = document.getElementById('apellido');
        const inputEmail = document.getElementById('email');
        const selectRol = document.getElementById('id_rol');
        const selectNacionalidad = document.getElementById('id_nacionalidad');
        const selectProvincia = document.getElementById('id_provincia');
        const selectLocalidad = document.getElementById('id_localidad');

        function mostrarError(mensaje) {
            alertContainer.innerHTML = `
                <div class="alert alert--error">
                    <i class="fa-solid fa-triangle-exclamation"></i>
                    ${mensaje}
                </div>
            `;
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        if (formulario && alertContainer) {
            formulario.addEventListener('submit', function(e) {
                alertContainer.innerHTML = '';

                const nombreVal = inputNombre?.value.trim() ?? '';
                if (nombreVal === '') {
                    e.preventDefault();
                    mostrarError('El nombre es obligatorio.');
                    inputNombre?.focus();
                    return;
                }
                if (!/^[a-zA-ZáéíóúÁÉÍÓÚñÑ\s]+$/.test(nombreVal)) {
                    e.preventDefault();
                    mostrarError('El nombre solo puede contener letras y espacios.');
                    inputNombre?.focus();
                    return;
                }

                const apellidoVal = inputApellido?.value.trim() ?? '';
                if (apellidoVal === '') {
                    e.preventDefault();
                    mostrarError('El apellido es obligatorio.');
                    inputApellido?.focus();
                    return;
                }
                if (!/^[a-zA-ZáéíóúÁÉÍÓÚñÑ\s]+$/.test(apellidoVal)) {
                    e.preventDefault();
                    mostrarError('El apellido solo puede contener letras y espacios.');
                    inputApellido?.focus();
                    return;
                }

                if (!selectNacionalidad || selectNacionalidad.value === '') {
                    e.preventDefault();
                    mostrarError('Debe seleccionar una nacionalidad.');
                    selectNacionalidad?.focus();
                    return;
                }

                if (!selectProvincia || selectProvincia.value === '') {
                    e.preventDefault();
                    mostrarError('Debe seleccionar una provincia.');
                    selectProvincia?.focus();
                    return;
                }

                if (!selectLocalidad || selectLocalidad.value === '') {
                    e.preventDefault();
                    mostrarError('Debe seleccionar una localidad.');
                    selectLocalidad?.focus();
                    return;
                }

                const emailVal = inputEmail?.value.trim() ?? '';
                if (emailVal === '') {
                    e.preventDefault();
                    mostrarError('El correo electrónico es obligatorio.');
                    inputEmail?.focus();
                    return;
                }
                const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/;
                if (!emailRegex.test(emailVal)) {
                    e.preventDefault();
                    mostrarError('El formato del correo electrónico no es válido (ej: nombre@dominio.com).');
                    inputEmail?.focus();
                    return;
                }

                if (!selectRol || selectRol.value === '') {
                    e.preventDefault();
                    mostrarError('Debe seleccionar un rol para el empleado.');
                    selectRol?.focus();
                    return;
                }
            });
        }

        if (inputNombre && inputApellido) {
            const inputsLetras = [inputNombre, inputApellido];
            inputsLetras.forEach(input => {
                input.addEventListener('keypress', function(e) {
                    const regex = /^[a-zA-ZáéíóúÁÉÍÓÚñÑ\s]$/;
                    if (!regex.test(e.key)) e.preventDefault();
                });
                input.addEventListener('input', function() {
                    this.value = this.value.replace(/[^a-zA-ZáéíóúÁÉÍÓÚñÑ\s]/g, '');
                });
                input.addEventListener('paste', function(e) {
                    const dataPegada = (e.clipboardData || window.clipboardData).getData('text');
                    const regexGeneral = /^[a-zA-ZáéíóúÁÉÍÓÚñÑ\s]+$/;
                    if (!regexGeneral.test(dataPegada)) {
                        e.preventDefault();
                        mostrarError('No se permite pegar números o símbolos en los campos de nombre o apellido.');
                    }
                });
                input.addEventListener('drop', function(e) { e.preventDefault(); });
            });
        }

        // --- 🌍 Lógica de Dependencia Escalonada de Ubicación (AJAX) ---
        const baseProvincias  = '<?= \App\Helpers\UrlHelper::to('/api/provincias') ?>';
        const baseLocalidades = '<?= \App\Helpers\UrlHelper::to('/api/localidades') ?>';

        const preloadedNacionalidad = '<?= $employee->getIdNacionalidad() ?? '' ?>';
        const preloadedProvincia    = '<?= $employee->getIdProvincia() ?? '' ?>';
        const preloadedLocalidad    = '<?= $employee->getIdLocalidad() ?? '' ?>';

        function poblarSelect(select, items, textoDefault, selectedId) {
            select.innerHTML = '<option value="" disabled>' + textoDefault + '</option>';
            items.forEach(function(item) {
                const opt = document.createElement('option');
                opt.value = item.id;
                opt.textContent = item.descripcion;
                if (selectedId && String(item.id) === String(selectedId)) {
                    opt.selected = true;
                }
                select.appendChild(opt);
            });
            select.disabled = false;
        }

        function resetSelect(select, texto) {
            select.innerHTML = '<option value="" disabled selected>' + texto + '</option>';
            select.disabled = true;
        }

        function cargarProvincias(nacionalidadId, provinciaSeleccionada) {
            return fetch(baseProvincias + '&nacionalidadId=' + encodeURIComponent(nacionalidadId))
                .then(function(resp) { return resp.json(); })
                .then(function(data) {
                    if (data.length > 0) {
                        poblarSelect(selectProvincia, data, 'Seleccione...', provinciaSeleccionada);
                    } else {
                        resetSelect(selectProvincia, 'Sin resultados');
                    }
                    return data;
                })
                .catch(function() {
                    resetSelect(selectProvincia, 'Error al cargar');
                    return [];
                });
        }

        function cargarLocalidades(provinciaId, localidadSeleccionada) {
            return fetch(baseLocalidades + '&provinciaId=' + encodeURIComponent(provinciaId))
                .then(function(resp) { return resp.json(); })
                .then(function(data) {
                    if (data.length > 0) {
                        poblarSelect(selectLocalidad, data, 'Seleccione...', localidadSeleccionada);
                    } else {
                        resetSelect(selectLocalidad, 'Sin resultados');
                    }
                    return data;
                })
                .catch(function() {
                    resetSelect(selectLocalidad, 'Error al cargar');
                    return [];
                });
        }

        // Precarga en modo edición: cargar provincias del país, luego ciudades de la provincia
        if (preloadedNacionalidad) {
            cargarProvincias(preloadedNacionalidad, preloadedProvincia)
                .then(function() {
                    if (preloadedProvincia) {
                        cargarLocalidades(preloadedProvincia, preloadedLocalidad);
                    }
                });
        }

        // Eventos de cambio en cascada
        if (selectNacionalidad && selectProvincia && selectLocalidad) {
            selectNacionalidad.addEventListener('change', function() {
                const nacionalidadId = this.value;
                if (nacionalidadId === "") {
                    resetSelect(selectProvincia, 'Seleccione una Nacionalidad primero...');
                    resetSelect(selectLocalidad, 'Seleccione una Provincia primero...');
                    return;
                }
                resetSelect(selectLocalidad, 'Seleccione una Provincia primero...');
                selectProvincia.innerHTML = '<option value="" disabled selected>Cargando...</option>';
                selectProvincia.disabled = true;

                cargarProvincias(nacionalidadId, '');
            });

            selectProvincia.addEventListener('change', function() {
                const provinciaId = this.value;
                if (provinciaId === "") {
                    resetSelect(selectLocalidad, 'Seleccione una Provincia primero...');
                    return;
                }
                selectLocalidad.innerHTML = '<option value="" disabled selected>Cargando...</option>';
                selectLocalidad.disabled = true;

                cargarLocalidades(provinciaId, '');
            });
        }
    });
</script>
