<script>
    document.addEventListener('DOMContentLoaded', function() {
        const formulario = document.querySelector('.employee-form');
        const alertContainer = document.getElementById('alert-container');
        const inputNombre = document.getElementById('nombre');
        const inputApellido = document.getElementById('apellido');
        const inputEmail = document.getElementById('email');
        const inputDni = document.getElementById('dni');
        const cuilGroup = document.getElementById('cuil-group');
        const inputFecha = document.getElementById('fecha_nacimiento');
        const inputCuil = document.getElementById('cuil');
        const selectRol = document.getElementById('id_rol');
        const selectNacionalidad = document.getElementById('id_nacionalidad');
        const selectProvincia = document.getElementById('id_provincia');
        const selectLocalidad = document.getElementById('id_localidad');

        function mostrarError(mensaje) {
            alertContainer.innerHTML = `
                <div class="alert alert--error">
                    <i class="fa-solid fa-triangle-exclamation"></i>
                    ${mensaje}
                </div>
            `;
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        // --- 🔢 Utilidades de validación ---
        function esArgentina(opcion) {
            return !!opcion && opcion.dataset.esArgentina === '1';
        }

        function cuilValido(value) {
            const digits = value.replace(/\D/g, '');
            if (!/^\d{11}$/.test(digits)) return false;
            const prefijo = parseInt(digits.slice(0, 2), 10);
            if (![20, 23, 24, 27].includes(prefijo)) return false;
            const pesos = [5, 4, 3, 2, 7, 6, 5, 4, 3, 2];
            let suma = 0;
            for (let i = 0; i < 10; i++) suma += parseInt(digits[i], 10) * pesos[i];
            let resto = suma % 11;
            let verificador;
            if (resto === 0) verificador = 0;
            else if (resto === 1) verificador = (prefijo === 23 || prefijo === 24) ? 9 : 4;
            else verificador = 11 - resto;
            return parseInt(digits[10], 10) === verificador;
        }

        function aplicarCuilSegunNacionalidad() {
            if (!cuilGroup || !inputCuil) return;
            const opcion = selectNacionalidad?.selectedOptions[0];
            const argentina = esArgentina(opcion);
            cuilGroup.style.display = argentina ? '' : 'none';
            if (!argentina) inputCuil.value = '';
        }

        // Estado inicial del CUIL (visible/oculto según nacionalidad precargada)
        aplicarCuilSegunNacionalidad();

        if (formulario && alertContainer) {
            formulario.addEventListener('submit', function(e) {
                alertContainer.innerHTML = '';

                const nombreVal = inputNombre?.value.trim() ?? '';
                if (nombreVal === '') {
                    e.preventDefault();
                    mostrarError('El nombre es obligatorio.');
                    inputNombre?.focus();
                    return;
                }
                if (!/^[a-zA-ZáéíóúÁÉÍÓÚñÑ\s]+$/.test(nombreVal)) {
                    e.preventDefault();
                    mostrarError('El nombre solo puede contener letras y espacios.');
                    inputNombre?.focus();
                    return;
                }

                const apellidoVal = inputApellido?.value.trim() ?? '';
                if (apellidoVal === '') {
                    e.preventDefault();
                    mostrarError('El apellido es obligatorio.');
                    inputApellido?.focus();
                    return;
                }
                if (!/^[a-zA-ZáéíóúÁÉÍÓÚñÑ\s]+$/.test(apellidoVal)) {
                    e.preventDefault();
                    mostrarError('El apellido solo puede contener letras y espacios.');
                    inputApellido?.focus();
                    return;
                }

                if (!selectNacionalidad || selectNacionalidad.value === '') {
                    e.preventDefault();
                    mostrarError('Debe seleccionar una nacionalidad.');
                    selectNacionalidad?.focus();
                    return;
                }

                if (!selectProvincia || selectProvincia.value === '') {
                    e.preventDefault();
                    mostrarError('Debe seleccionar una provincia.');
                    selectProvincia?.focus();
                    return;
                }

                // DNI / Documento
                const dniVal = (inputDni?.value || '').replace(/[^0-9]/g, '');
                if (inputDni) inputDni.value = dniVal;
                if (dniVal !== '' && !/^[0-9]{6,8}$/.test(dniVal)) {
                    e.preventDefault();
                    mostrarError('El formato del DNI no es válido. Debe contener entre 6 y 8 dígitos.');
                    inputDni?.focus();
                    return;
                }

                // CUIL (obligatorio y con dígito verificador solo para argentinos)
                const opcionNacionalidad = selectNacionalidad?.selectedOptions[0] ?? null;
                const cuilVal = (inputCuil?.value || '').replace(/\D/g, '');
                if (esArgentina(opcionNacionalidad)) {
                    if (cuilVal === '') {
                        e.preventDefault();
                        mostrarError('El CUIL es obligatorio para empleados argentinos.');
                        inputCuil?.focus();
                        return;
                    }
                    if (!cuilValido(cuilVal)) {
                        e.preventDefault();
                        mostrarError('El CUIL ingresado no es válido. Verifique el número y su dígito verificador.');
                        inputCuil?.focus();
                        return;
                    }
                } else if (cuilVal !== '' && !cuilValido(cuilVal)) {
                    e.preventDefault();
                    mostrarError('El CUIL ingresado no es válido. Verifique el número y su dígito verificador.');
                    inputCuil?.focus();
                    return;
                }

                const emailVal = inputEmail?.value.trim() ?? '';
                if (emailVal === '') {
                    e.preventDefault();
                    mostrarError('El correo electrónico es obligatorio.');
                    inputEmail?.focus();
                    return;
                }
                const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/;
                if (!emailRegex.test(emailVal)) {
                    e.preventDefault();
                    mostrarError('El formato del correo electrónico no es válido (ej: nombre@dominio.com).');
                    inputEmail?.focus();
                    return;
                }

                if (!selectRol || selectRol.value === '') {
                    e.preventDefault();
                    mostrarError('Debe seleccionar un rol para el empleado.');
                    selectRol?.focus();
                    return;
                }

                const fechaVal = inputFecha?.value ?? '';
                if (fechaVal !== '') {
                    const nacimiento = new Date(fechaVal + 'T00:00:00');
                    const hoy = new Date();
                    let edad = hoy.getFullYear() - nacimiento.getFullYear();
                    const mes = hoy.getMonth() - nacimiento.getMonth();
                    if (mes < 0 || (mes === 0 && hoy.getDate() < nacimiento.getDate())) {
                        edad--;
                    }
                    if (edad < 18) {
                        e.preventDefault();
                        mostrarError('El usuario debe ser mayor de edad (18 años o más).');
                        inputFecha?.focus();
                        return;
                    }
                    if (edad > 130) {
                        e.preventDefault();
                        mostrarError('La fecha de nacimiento indica una edad mayor a 130 años.');
                        inputFecha?.focus();
                        return;
                    }
                }
            });
        }

        if (inputNombre && inputApellido) {
            const inputsLetras = [inputNombre, inputApellido];
            inputsLetras.forEach(input => {
                input.addEventListener('keypress', function(e) {
                    const regex = /^[a-zA-ZáéíóúÁÉÍÓÚñÑ\s]$/;
                    if (!regex.test(e.key)) e.preventDefault();
                });
                input.addEventListener('input', function() {
                    this.value = this.value.replace(/[^a-zA-ZáéíóúÁÉÍÓÚñÑ\s]/g, '');
                });
                input.addEventListener('paste', function(e) {
                    const dataPegada = (e.clipboardData || window.clipboardData).getData('text');
                    const regexGeneral = /^[a-zA-ZáéíóúÁÉÍÓÚñÑ\s]+$/;
                    if (!regexGeneral.test(dataPegada)) {
                        e.preventDefault();
                        mostrarError('No se permite pegar números o símbolos en los campos de nombre o apellido.');
                    }
                });
                input.addEventListener('drop', function(e) { e.preventDefault(); });
            });
        }

        // --- 🌍 Lógica de Dependencia Escalonada de Ubicación (AJAX) ---
        const baseProvincias  = '<?= \App\Helpers\UrlHelper::to('/api/provincias') ?>';
        const baseLocalidades = '<?= \App\Helpers\UrlHelper::to('/api/localidades') ?>';

        const preloadedNacionalidad = '<?= $employee->getIdNacionalidad() ?? '' ?>';
        const preloadedProvincia    = '<?= $employee->getIdProvincia() ?? '' ?>';
        const preloadedLocalidad    = '<?= $employee->getIdLocalidad() ?? '' ?>';

        function poblarSelect(select, items, textoDefault, selectedId) {
            select.innerHTML = '<option value="" disabled>' + textoDefault + '</option>';
            items.forEach(function(item) {
                const opt = document.createElement('option');
                opt.value = item.id;
                opt.textContent = item.descripcion;
                if (selectedId && String(item.id) === String(selectedId)) {
                    opt.selected = true;
                }
                select.appendChild(opt);
            });
            select.disabled = false;
        }

        function resetSelect(select, texto) {
            select.innerHTML = '<option value="" disabled selected>' + texto + '</option>';
            select.disabled = true;
        }

        function cargarProvincias(nacionalidadId, provinciaSeleccionada) {
            return fetch(baseProvincias + '&nacionalidadId=' + encodeURIComponent(nacionalidadId))
                .then(function(resp) { return resp.json(); })
                .then(function(data) {
                    if (data.length > 0) {
                        poblarSelect(selectProvincia, data, 'Seleccione...', provinciaSeleccionada);
                    } else {
                        resetSelect(selectProvincia, 'Sin resultados');
                    }
                    return data;
                })
                .catch(function() {
                    resetSelect(selectProvincia, 'Error al cargar');
                    return [];
                });
        }

        function cargarLocalidades(provinciaId, localidadSeleccionada) {
            return fetch(baseLocalidades + '&provinciaId=' + encodeURIComponent(provinciaId))
                .then(function(resp) { return resp.json(); })
                .then(function(data) {
                    if (data.length > 0) {
                        poblarSelect(selectLocalidad, data, 'Seleccione...', localidadSeleccionada);
                    } else {
                        resetSelect(selectLocalidad, 'Sin resultados');
                    }
                    return data;
                })
                .catch(function() {
                    resetSelect(selectLocalidad, 'Error al cargar');
                    return [];
                });
        }

        // Precarga en modo edición: cargar provincias del país, luego ciudades de la provincia
        if (preloadedNacionalidad) {
            cargarProvincias(preloadedNacionalidad, preloadedProvincia)
                .then(function() {
                    if (preloadedProvincia) {
                        cargarLocalidades(preloadedProvincia, preloadedLocalidad);
                    }
                });
        }

        // Eventos de cambio en cascada
        if (selectNacionalidad && selectProvincia && selectLocalidad) {
            selectNacionalidad.addEventListener('change', function() {
                aplicarCuilSegunNacionalidad();
                const nacionalidadId = this.value;
                if (nacionalidadId === "") {
                    resetSelect(selectProvincia, 'Seleccione una Nacionalidad primero...');
                    resetSelect(selectLocalidad, 'Seleccione una Provincia primero...');
                    return;
                }
                resetSelect(selectLocalidad, 'Seleccione una Provincia primero...');
                selectProvincia.innerHTML = '<option value="" disabled selected>Cargando...</option>';
                selectProvincia.disabled = true;

                cargarProvincias(nacionalidadId, '');
            });

            selectProvincia.addEventListener('change', function() {
                const provinciaId = this.value;
                if (provinciaId === "") {
                    resetSelect(selectLocalidad, 'Seleccione una Provincia primero...');
                    return;
                }
                selectLocalidad.innerHTML = '<option value="" disabled selected>Cargando...</option>';
                selectLocalidad.disabled = true;

                cargarLocalidades(provinciaId, '');
            });
        }

        // --- 📞 Auto-formato Teléfono internacional ---
        const inputTelefono = document.getElementById('telefono');
        if (inputTelefono) {
            inputTelefono.addEventListener('input', function() {
                const soloDigitos = this.value.replace(/[^0-9]/g, '');
                this.value = soloDigitos === '' ? '' : '+' + soloDigitos.slice(0, 15);
            });
        }

        // --- 🔢 Normalización DNI (solo dígitos, máx. 8) ---
        if (inputDni) {
            inputDni.addEventListener('input', function() {
                this.value = this.value.replace(/[^0-9]/g, '').slice(0, 8);
            });
            inputDni.addEventListener('paste', function(e) {
                e.preventDefault();
                const dataPegada = (e.clipboardData || window.clipboardData).getData('text');
                this.value = dataPegada.replace(/[^0-9]/g, '').slice(0, 8);
            });
        }

        // --- 🔢 Máscara CUIL XX-XXXXXXXX-X ---
        if (inputCuil) {
            const formatCuil = function(value) {
                const digits = value.replace(/\D/g, '').slice(0, 11);
                let out = digits;
                if (digits.length > 2) out = digits.slice(0, 2) + '-' + digits.slice(2);
                if (digits.length > 10) out = out.slice(0, 11) + '-' + digits.slice(10);
                return out;
            };
            inputCuil.addEventListener('input', function() {
                this.value = formatCuil(this.value);
            });
            inputCuil.addEventListener('keydown', function(e) {
                if (e.key === 'Backspace') {
                    const pos = this.selectionStart;
                    if (this.value[pos - 1] === '-') {
                        e.preventDefault();
                        const digits = this.value.replace(/\D/g, '').slice(0, -1);
                        this.value = formatCuil(digits);
                        this.setSelectionRange(this.value.length, this.value.length);
                    }
                }
            });
            inputCuil.addEventListener('paste', function(e) {
                e.preventDefault();
                const dataPegada = (e.clipboardData || window.clipboardData).getData('text');
                this.value = formatCuil(dataPegada);
            });
        }
    });
</script>
