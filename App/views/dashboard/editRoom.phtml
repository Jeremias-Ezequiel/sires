<script>
    document.addEventListener('DOMContentLoaded', function() {
        const inputNumero = document.getElementById('numero');
        const inputPiso = document.getElementById('piso');
        const inputPrecio = document.getElementById('precio_noche_base');

        if (inputNumero) {
            inputNumero.addEventListener('keypress', function(e) {
                if (!/[0-9]/.test(e.key)) e.preventDefault();
            });
            inputNumero.addEventListener('input', function() {
                this.value = this.value.replace(/[^0-9]/g, '');
            });
            inputNumero.addEventListener('paste', function(e) {
                const dataPegada = (e.clipboardData || window.clipboardData).getData('text');
                if (!/^[0-9]+$/.test(dataPegada)) {
                    e.preventDefault();
                    document.getElementById('alert-container').innerHTML = `
                        <div class="alert alert--error">
                            <i class="fa-solid fa-triangle-exclamation"></i>
                            Solo se permiten números enteros en el número de habitación.
                        </div>
                    `;
                    window.scrollTo({ top: 0, behavior: 'smooth' });
                }
            });
        }

        if (inputPiso) {
            inputPiso.addEventListener('keypress', function(e) {
                if (!/[0-9]/.test(e.key)) e.preventDefault();
            });
            inputPiso.addEventListener('input', function() {
                this.value = this.value.replace(/[^0-9]/g, '');
            });
            inputPiso.addEventListener('paste', function(e) {
                const dataPegada = (e.clipboardData || window.clipboardData).getData('text');
                if (!/^[0-9]+$/.test(dataPegada)) {
                    e.preventDefault();
                    document.getElementById('alert-container').innerHTML = `
                        <div class="alert alert--error">
                            <i class="fa-solid fa-triangle-exclamation"></i>
                            Solo se permiten números enteros en el piso.
                        </div>
                    `;
                    window.scrollTo({ top: 0, behavior: 'smooth' });
                }
            });
        }

        if (inputPrecio) {
            inputPrecio.addEventListener('keypress', function(e) {
                if (!/[0-9.]/.test(e.key)) e.preventDefault();
            });
            inputPrecio.addEventListener('input', function() {
                this.value = this.value.replace(/[^0-9.]/g, '');
            });
            inputPrecio.addEventListener('paste', function(e) {
                const dataPegada = (e.clipboardData || window.clipboardData).getData('text');
                if (!/^[0-9]+(\.[0-9]{1,2})?$/.test(dataPegada)) {
                    e.preventDefault();
                    document.getElementById('alert-container').innerHTML = `
                        <div class="alert alert--error">
                            <i class="fa-solid fa-triangle-exclamation"></i>
                            Solo se permiten valores numéricos en el precio (ej: 15000 o 15000.50).
                        </div>
                    `;
                    window.scrollTo({ top: 0, behavior: 'smooth' });
                }
            });
        }
    });
</script>