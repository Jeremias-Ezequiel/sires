<script>
    document.addEventListener('DOMContentLoaded', function() {
        const inputPiso = document.getElementById('piso');
        const inputDesde = document.getElementById('numero_desde');
        const inputHasta = document.getElementById('numero_hasta');
        const inputPrecio = document.getElementById('precio_noche_base');
        const preview = document.getElementById('batch-preview');

        function actualizarPreview() {
            const piso = parseInt(inputPiso.value) || 0;
            const desde = parseInt(inputDesde.value) || 0;
            const hasta = parseInt(inputHasta.value) || 0;

            if (piso <= 0 || desde <= 0 || hasta <= 0 || desde > hasta) {
                preview.innerHTML = '<p class="form__help">Complete el rango (desde ≤ hasta) para ver la previsualización.</p>';
                return;
            }

            const total = hasta - desde + 1;
            let numeros = '';
            for (let i = desde; i <= hasta; i++) {
                numeros += `<span class="badge badge--disponible" style="margin: 2px; padding: 4px 10px;">${piso}${i.toString().padStart(2, '0')}</span> `;
            }

            preview.innerHTML = `
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
                    <strong style="font-size: 1.1em;">Se generarán <span id="preview-count">${total}</span> habitaciones</strong>
                </div>
                <div style="display: flex; flex-wrap: wrap; gap: 4px; margin-top: 8px; line-height: 2.2;">
                    ${numeros}
                </div>
            `;
        }

        [inputDesde, inputHasta].forEach(function(input) {
            if (input) {
                input.addEventListener('input', actualizarPreview);
                input.addEventListener('keypress', function(e) {
                    if (!/[0-9]/.test(e.key)) e.preventDefault();
                });
                input.addEventListener('input', function() {
                    this.value = this.value.replace(/[^0-9]/g, '');
                });
            }
        });

        if (inputPrecio) {
            inputPrecio.addEventListener('keypress', function(e) {
                if (!/[0-9.]/.test(e.key)) e.preventDefault();
            });
            inputPrecio.addEventListener('input', function() {
                this.value = this.value.replace(/[^0-9.]/g, '');
            });
        }

        actualizarPreview();
    });
</script>