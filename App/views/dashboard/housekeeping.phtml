<?php if (!empty($tareas) && is_array($tareas)): ?>
    <section class="details-section">
        <div class="details-table-wrapper">
            <table class="details-table">
                <thead>
                    <tr>
                        <th class="col-id">ID</th>
                        <th>Habitación</th>
                        <th>Tipo</th>
                        <th>Estado</th>
                        <th>Fecha Asignada</th>
                        <th>Empleado</th>
                        <th class="col-actions">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    <?php foreach ($tareas as $tarea):
                        $estadoLower = mb_strtolower($tarea['estado_descripcion'] ?? '', 'UTF-8');
                        $statusClass = 'badge--disponible';
                        if (strpos($estadoLower, 'pendient') !== false) {
                            $statusClass = 'badge--pendiente';
                        } elseif (strpos($estadoLower, 'progreso') !== false) {
                            $statusClass = 'badge--reservada';
                        } elseif (strpos($estadoLower, 'completad') !== false) {
                            $statusClass = 'badge--disponible';
                        } elseif (strpos($estadoLower, 'inspeccion') !== false) {
                            $statusClass = 'badge--ocupada';
                        }
                    ?>
                        <tr>
                            <td><strong>#<?= htmlspecialchars((string)$tarea['id']) ?></strong></td>
                            <td>#<?= htmlspecialchars((string)$tarea['habitacion_numero']) ?> (Piso <?= htmlspecialchars((string)$tarea['habitacion_piso']) ?>)</td>
                            <td><?= htmlspecialchars($tiposTarea[$tarea['tipo_tarea']] ?? $tarea['tipo_tarea']) ?></td>
                            <td><span class="badge <?= $statusClass ?>"><?= htmlspecialchars($tarea['estado_descripcion']) ?></span></td>
                            <td><?= htmlspecialchars($tarea['fecha_asignada']) ?></td>
                            <td><?= $tarea['empleado_nombre'] ? htmlspecialchars($tarea['empleado_nombre'] . ' ' . $tarea['empleado_apellido']) : 'Sin asignar' ?></td>
                            <td class="cell-actions">
                                <div class="actions-group-container">
                                    <a href="<?= url('/dashboard/housekeeping/detail?id=' . $tarea['id']) ?>" class="btn btn--icon btn--icon-pass" title="Ver Detalle">
                                        <i class="fas fa-eye"></i>
                                    </a>
                                    <?php if ($tarea['id_estado_tarea'] == Housekeeping::ESTADO_PENDIENTE): ?>
                                        <a href="<?= url('/dashboard/housekeeping/detail?id=' . $tarea['id'] . '#iniciar') ?>" class="btn btn--icon btn--icon-edit" title="Iniciar Tarea">
                                            <i class="fas fa-play"></i>
                                        </a>
                                    <?php endif; ?>
                                    <?php if ($tarea['id_estado_tarea'] == Housekeeping::ESTADO_EN_PROGRESO): ?>
                                        <a href="<?= url('/dashboard/housekeeping/detail?id=' . $tarea['id'] . '#completar') ?>" class="btn btn--icon btn--icon-success" title="Completar Tarea">
                                            <i class="fas fa-check"></i>
                                        </a>
                                    <?php endif; ?>
                                    <?php if ($tarea['id_estado_tarea'] == Housekeeping::ESTADO_COMPLETADA): ?>
                                        <a href="<?= url('/dashboard/housekeeping/detail?id=' . $tarea['id'] . '#inspeccionar') ?>" class="btn btn--icon btn--icon-success" title="Inspeccionar">
                                            <i class="fas fa-clipboard-check"></i>
                                        </a>
                                    <?php endif; ?>
                                </div>
                            </td>
                        </tr>
                    <?php endforeach; ?>
                </tbody>
            </table>
        </div>

        <?php if ($totalPages > 1): ?>
            <div class="pagination-container" style="display: flex; justify-content: center; align-items: center; margin-top: 20px; gap: 8px;">
                <?php if ($currentPage > 1): ?>
                    <?php $queryParams = $_GET; $queryParams['page'] = $currentPage - 1; ?>
                    <a href="<?= url('/dashboard/housekeeping?' . http_build_query($queryParams)) ?>" class="btn btn--ghost" style="padding: 6px 12px; font-size: 14px;">
                        <i class="fas fa-chevron-left"></i> Anterior
                    </a>
                <?php endif; ?>

                <div class="pagination-numbers" style="display: flex; gap: 5px;">
                    <?php for ($i = 1; $i <= $totalPages; $i++): ?>
                        <?php $queryParams = $_GET; $queryParams['page'] = $i; $isActivePage = ($i === $currentPage); ?>
                        <a href="<?= url('/dashboard/housekeeping?' . http_build_query($queryParams)) ?>"
                           style="padding: 6px 12px; border-radius: 4px; text-decoration: none; font-size: 14px; font-weight: bold;
                                  <?= $isActivePage
                                      ? 'background-color: var(--primary-color, #0056b3); color: #fff; pointer-events: none;'
                                      : 'background-color: #f1f3f5; color: #333; border: 1px solid #dee2e6;'
                                  ?>">
                            <?= $i ?>
                        </a>
                    <?php endfor; ?>
                </div>

                <?php if ($currentPage < $totalPages): ?>
                    <?php $queryParams = $_GET; $queryParams['page'] = $currentPage + 1; ?>
                    <a href="<?= url('/dashboard/housekeeping?' . http_build_query($queryParams)) ?>" class="btn btn--ghost" style="padding: 6px 12px; font-size: 14px;">
                        Siguiente <i class="fas fa-chevron-right"></i>
                    </a>
                <?php endif; ?>
            </div>
        <?php endif; ?>
    </section>
<?php else: ?>
