<script src="<?= asset('js/reserva-precio.js') ?>"></script>
<script src="<?= asset_v('js/calendario-disponibilidad.js') ?>"></script>
<script>
    var CLIENTES = <?= json_encode(array_map(function ($c) {
        return [
            'id'        => $c->getId(),
            'nombre'    => $c->getNombre() ?? '',
            'apellido'  => $c->getApellido() ?? '',
            'dni'       => $c->getDniPasaporte() ?? '',
            'email'     => $c->getEmail() ?? '',
            'telefono'  => $c->getTelefono() ?? '',
        ];
    }, $clientes ?? [])) ?>;

    var ROOMS = <?= json_encode(array_map(function (array $h) {
        return [
            'id'       => (int)$h['id'],
            'numero'   => (int)$h['numero'],
            'piso'     => (int)$h['piso'],
            'tipo'     => $h['tipo'] ?? '',
            'estado'   => $h['estado'] ?? '',
            'precio'   => (float)($h['precio_noche_base'] ?? 0),
            'capacidad'=> \App\Models\Habitacion::capacidadParaTipo((int)($h['id_tipo_habitacion'] ?? 0)),
        ];
    }, array_values($habitaciones ?? []))) ?>;

    // Reservas que ocupan noches, con estado (mismos colores que el Planning) y cliente para la agenda
    var RESERVAS = <?= json_encode(array_map(function (array $r) {
        return [
            'id'         => (int)$r['id'],
            'habitacion' => (int)$r['id_habitacion'],
            'entrada'    => $r['fecha_entrada'],
            'salida'     => $r['fecha_salida'],
            'estilo'     => \App\Dominio\Planning::estilo((int)$r['id_estado_reserva'], (string)$r['fecha_salida'], date('Y-m-d')),
            'cliente'    => trim(($r['cliente_apellido'] ?? '') . ', ' . ($r['cliente_nombre'] ?? ''), ', '),
        ];
    }, $reservasActivas ?? []), JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT) ?>;
    var PLANNING_ESTILOS = <?= json_encode(\App\Dominio\Planning::ESTILOS, JSON_HEX_TAG | JSON_HEX_AMP) ?>;
    var URL_DETALLE_RESERVA = <?= json_encode(url('/dashboard/booking/detail'), JSON_HEX_TAG | JSON_HEX_AMP) ?>;

    var RESERVA_ID_A_IGNORAR = <?= (int)($reservaIdAExcluir ?? 0) ?>;

    document.addEventListener('DOMContentLoaded', function() {
        var searchInput = document.getElementById('cliente-search');
        var hiddenInput = document.getElementById('id_cliente');
        var dropdown = document.getElementById('cliente-dropdown');
        var confirmCard = document.getElementById('cliente-confirm-card');
        var confirmedId = parseInt(hiddenInput.value) || null;
        var highlightedIndex = -1;

        function filterByDni(query) {
            if (!query) return [];
            var q = query.toLowerCase();
            var exact = [];
            var partial = [];
            CLIENTES.forEach(function(c) {
                var dni = c.dni.toLowerCase();
                if (dni === q) {
                    exact.push(c);
                } else if (dni.indexOf(q) !== -1) {
                    partial.push(c);
                }
            });
            if (exact.length > 0) return { type: 'exact', results: exact };
            if (partial.length > 0) return { type: 'partial', results: partial };
            return { type: 'none', results: [] };
        }

        function renderDNIResults(filtered) {
            dropdown.innerHTML = '';
            confirmCard.style.display = 'none';

            if (filtered.type === 'none') {
                dropdown.innerHTML = '<div class="autocomplete-no-results">Cliente no registrado con ese DNI</div>';
                dropdown.classList.add('open');
                return;
            }

            if (filtered.type === 'exact') {
                var c = filtered.results[0];
                confirmCard.innerHTML =
                    '<div class="confirm-card-header">' +
                        '<i class="fas fa-check-circle confirm-icon"></i>' +
                        '<span class="confirm-label">Cliente encontrado</span>' +
                    '</div>' +
                    '<div class="confirm-card-body">' +
                        '<div class="confirm-field"><span class="confirm-field-label">Nombre</span><span class="confirm-field-value">' + escHtml(c.nombre + ' ' + c.apellido) + '</span></div>' +
                        '<div class="confirm-field"><span class="confirm-field-label">DNI</span><span class="confirm-field-value">' + escHtml(c.dni) + '</span></div>' +
                        '<div class="confirm-field"><span class="confirm-field-label">Email</span><span class="confirm-field-value">' + escHtml(c.email || '-') + '</span></div>' +
                        '<div class="confirm-field"><span class="confirm-field-label">Teléfono</span><span class="confirm-field-value">' + escHtml(c.telefono || '-') + '</span></div>' +
                    '</div>';
                confirmCard.style.display = 'block';
                dropdown.classList.remove('open');
                confirmedId = c.id;
                hiddenInput.value = c.id;
                searchInput.setCustomValidity('');
                return;
            }

            dropdown.classList.add('open');
            var q = searchInput.value.toLowerCase();
            filtered.results.forEach(function(c, i) {
                var item = document.createElement('div');
                item.className = 'autocomplete-item';
                item.dataset.id = c.id;
                item.dataset.nombre = c.nombre;
                item.dataset.apellido = c.apellido;
                item.dataset.dni = c.dni;
                item.dataset.email = c.email;
                item.dataset.telefono = c.telefono;
                item.innerHTML = highlightMatch(c.nombre + ' ' + c.apellido, q) + ' <small>' + escHtml(c.dni) + '</small>';
                item.addEventListener('click', function() {
                    confirmExact(c);
                });
                dropdown.appendChild(item);
            });
            highlightedIndex = -1;
        }

        function confirmExact(c) {
            confirmedId = c.id;
            hiddenInput.value = c.id;
            searchInput.value = c.dni;
            searchInput.setCustomValidity('');
            dropdown.classList.remove('open');
            confirmCard.innerHTML =
                '<div class="confirm-card-header">' +
                    '<i class="fas fa-check-circle confirm-icon"></i>' +
                    '<span class="confirm-label">Cliente encontrado</span>' +
                '</div>' +
                '<div class="confirm-card-body">' +
                    '<div class="confirm-field"><span class="confirm-field-label">Nombre</span><span class="confirm-field-value">' + escHtml(c.nombre + ' ' + c.apellido) + '</span></div>' +
                    '<div class="confirm-field"><span class="confirm-field-label">DNI</span><span class="confirm-field-value">' + escHtml(c.dni) + '</span></div>' +
                    '<div class="confirm-field"><span class="confirm-field-label">Email</span><span class="confirm-field-value">' + escHtml(c.email || '-') + '</span></div>' +
                    '<div class="confirm-field"><span class="confirm-field-label">Teléfono</span><span class="confirm-field-value">' + escHtml(c.telefono || '-') + '</span></div>' +
                '</div>';
            confirmCard.style.display = 'block';
        }

        function highlightMatch(text, query) {
            if (!query) return text;
            var idx = text.toLowerCase().indexOf(query);
            if (idx === -1) return text;
            return text.substring(0, idx) + '<strong>' + text.substring(idx, idx + query.length) + '</strong>' + text.substring(idx + query.length);
        }

        searchInput.addEventListener('input', function() {
            var val = this.value.trim();
            if (!val) {
                hiddenInput.value = '';
                confirmedId = null;
                dropdown.classList.remove('open');
                confirmCard.style.display = 'none';
                this.setCustomValidity('');
                return;
            }
            if (confirmedId !== null) {
                var match = CLIENTES.find(function(c) { return c.id === confirmedId; });
                if (match && this.value === match.dni) {
                    dropdown.classList.remove('open');
                    return;
                }
            }
            confirmedId = null;
            hiddenInput.value = '';
            confirmCard.style.display = 'none';
            var filtered = filterByDni(val);
            renderDNIResults(filtered);
        });

        searchInput.addEventListener('keydown', function(e) {
            var items = dropdown.querySelectorAll('.autocomplete-item');
            if (e.key === 'ArrowDown') {
                e.preventDefault();
                highlightedIndex = Math.min(highlightedIndex + 1, items.length - 1);
                updateHighlight(items);
            } else if (e.key === 'ArrowUp') {
                e.preventDefault();
                highlightedIndex = Math.max(highlightedIndex - 1, -1);
                updateHighlight(items);
            } else if (e.key === 'Enter') {
                if (items.length > 0 && highlightedIndex >= 0 && items[highlightedIndex]) {
                    e.preventDefault();
                    var item = items[highlightedIndex];
                    confirmExact({
                        id: parseInt(item.dataset.id),
                        nombre: item.dataset.nombre,
                        apellido: item.dataset.apellido,
                        dni: item.dataset.dni,
                        email: item.dataset.email,
                        telefono: item.dataset.telefono
                    });
                } else if (confirmedId) {
                    e.preventDefault();
                }
            } else if (e.key === 'Escape') {
                dropdown.classList.remove('open');
            }
        });

        function updateHighlight(items) {
            items.forEach(function(item, i) {
                item.classList.toggle('highlighted', i === highlightedIndex);
            });
            if (highlightedIndex >= 0 && items[highlightedIndex]) {
                items[highlightedIndex].scrollIntoView({ block: 'nearest' });
            }
        }

        /* --- Room search --- */
        var roomSearch = document.getElementById('habitacion-search');
        var roomHidden = document.getElementById('id_habitacion');
        var roomDropdown = document.getElementById('habitacion-dropdown');
        var roomConfirmCard = document.getElementById('habitacion-confirm-card');
        var roomConfirmedId = parseInt(roomHidden.value) || null;
        var roomHighlightIdx = -1;

        var guestInput = document.getElementById('cantidad_huespedes');
        var entrada = document.getElementById('fecha_entrada');
        var salida = document.getElementById('fecha_salida');

        var RESERVAS_POR_HABITACION = {};
        RESERVAS.forEach(function(r) {
            if (!RESERVAS_POR_HABITACION[r.habitacion]) {
                RESERVAS_POR_HABITACION[r.habitacion] = [];
            }
            RESERVAS_POR_HABITACION[r.habitacion].push(r);
        });

        function fechasSeSolapan(e1, s1, e2, s2) {
            return e1 < s2 && s1 > e2;
        }

        function habitacionOcupadaEnFechas(r) {
            var e = entrada && entrada.value;
            var s = salida && salida.value;
            if (!e || !s) return false;
            var res = RESERVAS_POR_HABITACION[r.id] || [];
            for (var i = 0; i < res.length; i++) {
                if (res[i].id === RESERVA_ID_A_IGNORAR) continue;
                if (fechasSeSolapan(e, s, res[i].entrada, res[i].salida)) return true;
            }
            return false;
        }

        // Fuente única: tabla Configuracion (ConfiguracionService::descuentoOcupacion)
        var DESCUENTOS_TABLA = <?= json_encode(\App\Services\ConfiguracionService::descuentoOcupacion()) ?>;

        function descuentoOcupacion(capacidad, huespedes) {
            return SiresPrecio.descuentoOcupacion(DESCUENTOS_TABLA, capacidad, huespedes);
        }

        function actualizarPrecioOcupacion() {
            if (!guestInput || !roomConfirmedId) return;
            var r = ROOMS.find(function(x) { return x.id === roomConfirmedId; });
            var ayuda = document.getElementById('precio-ocupacion-ayuda');
            var precioNocheEl = document.getElementById('room-precio-noche');
            var precioTotalEl = document.getElementById('room-precio-total');
            if (!r) return;
            var huespedes = parseInt(guestInput.value, 10) || 1;
            var dsc = descuentoOcupacion(r.capacidad, huespedes);
            var precio = SiresPrecio.precioNoche(r.precio, dsc);

            var noches = SiresPrecio.calcularNoches(entrada && entrada.value, salida && salida.value);
            var total = precio * noches;

            if (ayuda) {
                ayuda.textContent = 'Descuento por ocupación: ' + dsc + '% — Precio/noche: ' + SiresPrecio.formatearMoneda(precio);
            }
            if (precioNocheEl) {
                precioNocheEl.textContent = SiresPrecio.formatearMoneda(precio) + (dsc > 0 ? ' (-' + dsc + '%)' : '');
            }
            if (precioTotalEl) {
                precioTotalEl.textContent = SiresPrecio.formatearMoneda(total) + ' (' + noches + (noches === 1 ? ' noche' : ' noches') + ' x ' + SiresPrecio.formatearMoneda(precio) + ')';
            }
        }

        function aplicarCapacidad(r) {
            if (!guestInput || !r || !r.capacidad) return;
            guestInput.max = r.capacidad;
            var val = parseInt(guestInput.value, 10) || 1;
            if (val > r.capacidad) {
                guestInput.value = r.capacidad;
            }
            actualizarPrecioOcupacion();
        }

        var timelineContainer = document.getElementById('timeline-container');
        var calendario = SiresCalendario.crear({
            contenedor: timelineContainer,
            entrada: entrada,
            salida: salida,
            ignorarId: RESERVA_ID_A_IGNORAR,
            estilos: PLANNING_ESTILOS,
            urlDetalle: URL_DETALLE_RESERVA
        });

        function renderizarTimelineOcupacion(roomId) {
            if (!roomId) {
                calendario.ocultar();
                return;
            }
            calendario.mostrar(RESERVAS_POR_HABITACION[roomId] || []);
        }

        if (guestInput) {
            guestInput.addEventListener('input', actualizarPrecioOcupacion);
            guestInput.addEventListener('change', actualizarPrecioOcupacion);
        }

        if (roomConfirmedId) {
            var match = ROOMS.find(function(r) { return r.id === roomConfirmedId; });
            if (match) {
                showRoomConfirmCard(match);
                roomSearch.value = '#' + match.numero + ' - Piso ' + match.piso + ' (' + match.tipo + ')';
                aplicarCapacidad(match);
                renderizarTimelineOcupacion(match.id);
            }
        }

        function filterRooms(query) {
            if (!query) return [];
            var q = query.toLowerCase();
            var exact = [];
            var partial = [];
            ROOMS.forEach(function(r) {
                var num = String(r.numero);
                var label = '#' + r.numero + ' - piso ' + r.piso + ' (' + r.tipo.toLowerCase() + ')';
                if (num === q || '#' + num === q) {
                    exact.push(r);
                } else if (label.indexOf(q) !== -1 || r.tipo.toLowerCase().indexOf(q) !== -1 || String(r.piso).indexOf(q) !== -1) {
                    partial.push(r);
                }
            });
            // Las ocupadas en las fechas cargadas también se listan, en su orden (las fechas
            // del formulario son un valor por defecto): solo llevan la marca "Ocupada en esas fechas"
            if (exact.length > 0) return { type: 'exact', results: exact };
            if (partial.length > 0) return { type: 'partial', results: partial };
            return { type: 'none', results: [] };
        }

        function renderRoomResults(filtered) {
            roomDropdown.innerHTML = '';
            roomConfirmCard.style.display = 'none';
            calendario.ocultar();

            if (filtered.type === 'none') {
                roomDropdown.innerHTML = '<div class="autocomplete-no-results">No se encontraron habitaciones</div>';
                roomDropdown.classList.add('open');
                return;
            }

            if (filtered.type === 'exact') {
                var r = filtered.results[0];
                roomConfirmedId = r.id;
                roomHidden.value = r.id;
                roomDropdown.classList.remove('open');
                showRoomConfirmCard(r);
                roomSearch.setCustomValidity('');
                aplicarCapacidad(r);
                renderizarTimelineOcupacion(r.id);
                actualizarPrecioOcupacion();
                return;
            }

            roomDropdown.classList.add('open');
            var q = roomSearch.value.toLowerCase();
            filtered.results.forEach(function(r, i) {
                var item = document.createElement('div');
                item.className = 'autocomplete-item';
                item.dataset.id = r.id;
                item.dataset.numero = r.numero;
                item.dataset.piso = r.piso;
                item.dataset.tipo = r.tipo;
                item.dataset.estado = r.estado;
                item.dataset.precio = r.precio;
                item.dataset.capacidad = r.capacidad;
                var label = '#' + r.numero + ' - Piso ' + r.piso;
                item.innerHTML = highlightMatch(label, q) + ' <small>' + escHtml(r.tipo) + '</small>' +
                    (habitacionOcupadaEnFechas(r) ? ' <span class="autocomplete-item__aviso">Ocupada en esas fechas</span>' : '');
                item.addEventListener('click', function() {
                    confirmRoom(r);
                });
                roomDropdown.appendChild(item);
            });
            roomHighlightIdx = -1;
        }

        function confirmRoom(r) {
            roomConfirmedId = r.id;
            roomHidden.value = r.id;
            roomSearch.value = '#' + r.numero + ' - Piso ' + r.piso + ' (' + r.tipo + ')';
            roomSearch.setCustomValidity('');
            roomDropdown.classList.remove('open');
            showRoomConfirmCard(r);
            aplicarCapacidad(r);
            renderizarTimelineOcupacion(r.id);
        }

        function showRoomConfirmCard(r) {
            roomConfirmCard.innerHTML =
                '<div class="confirm-card-header">' +
                    '<i class="fas fa-door-open confirm-icon"></i>' +
                    '<span class="confirm-label">Habitación seleccionada</span>' +
                '</div>' +
                '<div class="confirm-card-body">' +
                    '<div class="confirm-field"><span class="confirm-field-label">Habitación</span><span class="confirm-field-value">#' + escHtml(String(r.numero)) + '</span></div>' +
                    '<div class="confirm-field"><span class="confirm-field-label">Piso</span><span class="confirm-field-value">' + escHtml(String(r.piso)) + '</span></div>' +
                    '<div class="confirm-field"><span class="confirm-field-label">Tipo</span><span class="confirm-field-value">' + escHtml(r.tipo) + '</span></div>' +
                    '<div class="confirm-field"><span class="confirm-field-label">Capacidad</span><span class="confirm-field-value">' + escHtml(String(r.capacidad)) + ' personas</span></div>' +
                    '<div class="confirm-field"><span class="confirm-field-label">Disponibilidad</span><span class="confirm-field-value" id="room-disponibilidad"></span></div>' +
                    '<div class="confirm-field"><span class="confirm-field-label">Precio/noche</span><span class="confirm-field-value" id="room-precio-noche">$0,00</span></div>' +
                    '<div class="confirm-field"><span class="confirm-field-label">Total estimado</span><span class="confirm-field-value" id="room-precio-total">$0,00</span></div>' +
                '</div>';
            roomConfirmCard.style.display = 'block';
            roomDropdown.classList.remove('open');
            marcarDisponibilidad(r);
        }

        /**
         * Texto de disponibilidad de la tarjeta y validación del formulario: una habitación
         * ocupada en esas fechas se puede elegir (para ver su agenda y buscar días libres),
         * pero no se puede guardar la reserva hasta elegir fechas libres. El servidor vuelve a validar.
         */
        function marcarDisponibilidad(r) {
            var ocupada = habitacionOcupadaEnFechas(r);
            var el = document.getElementById('room-disponibilidad');
            if (el) {
                el.textContent = ocupada ? 'Ocupada en esas fechas: elegí días libres en la agenda' : 'Disponible para las fechas ingresadas';
                el.classList.toggle('text-danger', ocupada);
            }
            entrada.setCustomValidity(ocupada ? 'La habitación está ocupada en esas fechas. Elegí días libres en la agenda.' : '');
        }

        roomSearch.addEventListener('input', function() {
            var val = this.value.trim();
            if (!val) {
                roomHidden.value = '';
                roomConfirmedId = null;
                entrada.setCustomValidity(''); // sin habitación elegida no hay choque que marcar
                roomDropdown.classList.remove('open');
                roomConfirmCard.style.display = 'none';
                calendario.ocultar();
                this.setCustomValidity('');
                return;
            }
            if (roomConfirmedId !== null) {
                var match = ROOMS.find(function(r) { return r.id === roomConfirmedId; });
                if (match) {
                    var expected = '#' + match.numero + ' - Piso ' + match.piso + ' (' + match.tipo + ')';
                    if (this.value === expected) {
                        roomDropdown.classList.remove('open');
                        return;
                    }
                }
            }
            roomConfirmedId = null;
            entrada.setCustomValidity(''); // sin habitación elegida no hay choque que marcar
            roomHidden.value = '';
            roomConfirmCard.style.display = 'none';
            var filtered = filterRooms(val);
            renderRoomResults(filtered);
        });

        roomSearch.addEventListener('keydown', function(e) {
            var items = roomDropdown.querySelectorAll('.autocomplete-item');
            if (e.key === 'ArrowDown') {
                e.preventDefault();
                roomHighlightIdx = Math.min(roomHighlightIdx + 1, items.length - 1);
                updateRoomHighlight(items);
            } else if (e.key === 'ArrowUp') {
                e.preventDefault();
                roomHighlightIdx = Math.max(roomHighlightIdx - 1, -1);
                updateRoomHighlight(items);
            } else if (e.key === 'Enter') {
                if (items.length > 0 && roomHighlightIdx >= 0 && items[roomHighlightIdx]) {
                    e.preventDefault();
                    var item = items[roomHighlightIdx];
                    confirmRoom({
                        id: parseInt(item.dataset.id),
                        numero: parseInt(item.dataset.numero),
                        piso: parseInt(item.dataset.piso),
                        tipo: item.dataset.tipo,
                        estado: item.dataset.estado,
                        precio: parseFloat(item.dataset.precio),
                        capacidad: parseInt(item.dataset.capacidad) || 2
                    });
                } else if (roomConfirmedId) {
                    e.preventDefault();
                }
            } else if (e.key === 'Escape') {
                roomDropdown.classList.remove('open');
            }
        });

        function updateRoomHighlight(items) {
            items.forEach(function(item, i) {
                item.classList.toggle('highlighted', i === roomHighlightIdx);
            });
            if (roomHighlightIdx >= 0 && items[roomHighlightIdx]) {
                items[roomHighlightIdx].scrollIntoView({ block: 'nearest' });
            }
        }

        roomSearch.addEventListener('invalid', function() {
            if (!roomHidden.value) {
                this.setCustomValidity('Seleccione una habitación de la lista');
            }
        });

        roomSearch.addEventListener('input', function() {
            this.setCustomValidity('');
        });

        document.addEventListener('click', function(e) {
            if (!e.target.closest('.autocomplete-wrapper')) {
                dropdown.classList.remove('open');
                roomDropdown.classList.remove('open');
            }
        });

        searchInput.addEventListener('blur', function() {
            setTimeout(function() {
                if (!dropdown.contains(document.activeElement)) {
                    dropdown.classList.remove('open');
                }
            }, 150);
        });

        roomSearch.addEventListener('blur', function() {
            setTimeout(function() {
                if (!roomDropdown.contains(document.activeElement)) {
                    roomDropdown.classList.remove('open');
                }
            }, 150);
        });

        searchInput.addEventListener('invalid', function() {
            if (!hiddenInput.value) {
                this.setCustomValidity('Ingrese un DNI de cliente válido');
            }
        });

        searchInput.addEventListener('input', function() {
            this.setCustomValidity('');
        });

        function actualizarDisponibilidadHabitaciones() {
            if (roomConfirmedId !== null) {
                var match = ROOMS.find(function(r) { return r.id === roomConfirmedId; });
                // Ya no se descarta la habitación si las fechas chocan: la agenda muestra el
                // choque y el formulario no se envía hasta que las fechas queden libres.
                if (match) marcarDisponibilidad(match);
                renderizarTimelineOcupacion(roomConfirmedId);
            }
        }

        if (entrada && salida) {
            entrada.addEventListener('change', function() {
                if (salida.value && salida.value <= this.value) {
                    var nextDay = new Date(this.value);
                    nextDay.setDate(nextDay.getDate() + 1);
                    salida.value = nextDay.toISOString().split('T')[0];
                }
                salida.min = this.value;
                actualizarDisponibilidadHabitaciones();
            });

            salida.addEventListener('change', function() {
                if (entrada.value && this.value <= entrada.value) {
                    alert('La fecha de salida debe ser posterior a la fecha de entrada.');
                    this.value = '';
                }
                actualizarDisponibilidadHabitaciones();
            });
        }
    });
</script>