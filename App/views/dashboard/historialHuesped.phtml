<?php if (!empty($reservas)): ?>
    <section class="details-section">
        <h3 style="margin-bottom: 15px;">Reservas</h3>
        <div class="details-table-wrapper">
            <table class="details-table">
                <thead>
                    <tr>
                        <th class="col-id">ID</th>
                        <th>Habitación</th>
                        <th>Fecha Entrada</th>
                        <th>Fecha Salida</th>
                        <th>Noches</th>
                        <th>Estado</th>
                        <th>Total</th>
                        <th>Saldo</th>
                    </tr>
                </thead>
                <tbody>
                    <?php foreach ($reservas as $reserva):
                        $estadoLower = mb_strtolower($reserva['estado_reserva'] ?? '', 'UTF-8');
                        $statusClass = 'badge--disponible';
                        if (strpos($estadoLower, 'pendient') !== false) {
                            $statusClass = 'badge--pendiente';
                        } elseif (strpos($estadoLower, 'confirm') !== false) {
                            $statusClass = 'badge--reservada';
                        } elseif (strpos($estadoLower, 'cancel') !== false) {
                            $statusClass = 'badge--ocupada';
                        } elseif (strpos($estadoLower, 'finaliz') !== false) {
                            $statusClass = 'badge--disponible';
                        }

                        $saldo = isset($reserva['saldo_pendiente']) && $reserva['saldo_pendiente'] !== null ? (float)$reserva['saldo_pendiente'] : 0.0;
                        $noches = (new DateTime($reserva['fecha_entrada']))->diff(new DateTime($reserva['fecha_salida']))->days;
                    ?>
                        <tr>
                            <td><strong>#<?= htmlspecialchars((string)$reserva['id']) ?></strong></td>
                            <td>#<?= htmlspecialchars((string)$reserva['habitacion_numero']) ?> (Piso <?= htmlspecialchars((string)$reserva['habitacion_piso']) ?>)</td>
                            <td><?= htmlspecialchars($reserva['fecha_entrada']) ?></td>
                            <td><?= htmlspecialchars($reserva['fecha_salida']) ?></td>
                            <td><?= $noches ?></td>
                            <td><span class="badge <?= $statusClass ?>"><?= htmlspecialchars($reserva['estado_reserva']) ?></span></td>
                            <td><?= isset($reserva['monto_total']) && $reserva['monto_total'] !== null ? '$' . number_format((float)$reserva['monto_total'], 2, ',', '.') : '-' ?></td>
                            <td style="<?= $saldo > 0 ? 'color: #dc3545; font-weight: bold;' : 'color: #28a745;' ?>">
                                <?= isset($reserva['saldo_pendiente']) && $reserva['saldo_pendiente'] !== null ? '$' . number_format($saldo, 2, ',', '.') : '-' ?>
                            </td>
                        </tr>
                    <?php endforeach; ?>
                </tbody>
            </table>
        </div>
    </section>
<?php else: ?>
    <section class="details-section no-results-container">
        <div class="no-results-content">
            <div class="no-results-icon-frame">
                <i class="fas fa-history"></i>
            </div>
            <h3>Sin reservas</h3>
            <p>Este cliente no tiene reservas registradas.</p>
        </div>
    </section>
<?php endif; ?>
